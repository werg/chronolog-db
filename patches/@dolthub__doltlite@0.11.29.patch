+  manifest.Set("chronologPatchProfile", "authorizer-progress-limits-tailoffset-dolt-refs-static-vec-dolt-compat-v1");
+  manifest.Set("fts5", true);
+  manifest.Set("json1", true);
+  manifest.Set("rtree", true);
+  manifest.Set("dynamicExtensions", false);
+  return manifest;
+}
 
 Napi::Object Init(Napi::Env env, Napi::Object exports) {
   doltliteInstallAutoExt();
+  // sqlite-vec is statically linked into the same SQLite/DoltLite artifact.
+  // Register it before any Database instance opens so every writer and pinned
+  // reader connection receives exactly the same module and scalar functions.
+  if (sqlite3_auto_extension(reinterpret_cast<void (*)(void)>(sqlite3_vec_init)) != SQLITE_OK) {
+    Napi::Error::New(env, "Failed to register statically linked sqlite-vec").ThrowAsJavaScriptException();
+    return exports;
+  }
   // StatementSync must be initialised first so its constructor_ is set before
   // Database::Prepare() can call Statement::Create().
   Statement::Init(env, exports);
   Database::Init(env, exports);
+  exports.Set("chronologNativeManifest", Napi::Function::New(env, ChronologNativeManifest));
   return exports;
 }
 
