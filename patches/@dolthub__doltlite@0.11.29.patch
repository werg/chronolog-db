+Napi::Value Database::ConfigureSecurity(const Napi::CallbackInfo& info) {
+  Napi::Env env = info.Env();
+  if (!db_) { Napi::Error::New(env, "Database is closed").ThrowAsJavaScriptException(); return env.Undefined(); }
+  auto result = Napi::Object::New(env);
+  auto configure = [this, env, result](const char* name, int operation, int value) -> bool {
+    int applied = -1;
+    int rc = sqlite3_db_config(db_, operation, value, &applied);
+    if (rc != SQLITE_OK || applied != value) {
+      Napi::Error::New(env, std::string("Failed security db_config: ") + name)
+          .ThrowAsJavaScriptException();
+      return false;
+    }
+    result.Set(name, Napi::Boolean::New(env, true));
+    return true;
+  };
+#define APPLY_REQUIRED(name, operation, value) \
+  do { if (!configure(name, operation, value)) return env.Undefined(); } while (0)
+  APPLY_REQUIRED("defensive", SQLITE_DBCONFIG_DEFENSIVE, 1);
+  APPLY_REQUIRED("trustedSchema", SQLITE_DBCONFIG_TRUSTED_SCHEMA, 0);
+  APPLY_REQUIRED("loadExtension", SQLITE_DBCONFIG_ENABLE_LOAD_EXTENSION, 0);
+  APPLY_REQUIRED("dqsDml", SQLITE_DBCONFIG_DQS_DML, 0);
+  APPLY_REQUIRED("dqsDdl", SQLITE_DBCONFIG_DQS_DDL, 0);
+  APPLY_REQUIRED("qpsg", SQLITE_DBCONFIG_ENABLE_QPSG, 1);
+  APPLY_REQUIRED("ftsTokenizer", SQLITE_DBCONFIG_ENABLE_FTS3_TOKENIZER, 0);
+  APPLY_REQUIRED("writableSchema", SQLITE_DBCONFIG_WRITABLE_SCHEMA, 0);
+#ifdef SQLITE_DBCONFIG_ENABLE_ATTACH_CREATE
+  APPLY_REQUIRED("attachCreate", SQLITE_DBCONFIG_ENABLE_ATTACH_CREATE, 0);
+#endif
+#ifdef SQLITE_DBCONFIG_ENABLE_ATTACH_WRITE
+  APPLY_REQUIRED("attachWrite", SQLITE_DBCONFIG_ENABLE_ATTACH_WRITE, 0);
+#endif
+#ifdef SQLITE_DBCONFIG_REVERSE_SCANORDER
+  APPLY_REQUIRED("reverseScanOrder", SQLITE_DBCONFIG_REVERSE_SCANORDER, 0);
+#endif
+#ifdef SQLITE_DBCONFIG_FP_DIGITS
+  APPLY_REQUIRED("fpDigits", SQLITE_DBCONFIG_FP_DIGITS, 17);
+#else
+  Napi::Error::New(env, "Pinned DoltLite build lacks SQLITE_DBCONFIG_FP_DIGITS")
+      .ThrowAsJavaScriptException();
+  return env.Undefined();
+#endif
+  result.Set("extendedResultCodes", Napi::Boolean::New(env, true));
+#undef APPLY_REQUIRED
+  return result;
+}
