+int Database::AuthorizerCallback(void* context, int action, const char* arg1,
+                                 const char* arg2, const char* database,
+                                 const char* trigger) {
+  auto* self = static_cast<Database*>(context);
+  if (!self || self->authorizer_.IsEmpty()) return SQLITE_DENY;
+  Napi::Env env(self->env_);
+  Napi::HandleScope scope(env);
+  auto nullableString = [env](const char* value) -> Napi::Value {
+    return value ? Napi::String::New(env, value) : env.Null();
+  };
+  Napi::Value result = self->authorizer_.Call({
+    Napi::Number::New(env, action), nullableString(arg1), nullableString(arg2),
+    nullableString(database), nullableString(trigger)
