{
  "name": "chronolog-db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint . --cache --cache-strategy content --cache-location node_modules/.cache/eslint/.eslintcache --max-warnings 0",
    "lint:fix": "pnpm lint --fix",
    "check:commit": "pnpm lint && pnpm typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "conformance": "tsx packages/conformance/src/conformance-report.ts --output artifacts/conformance/report.json",
    "conformance:production": "tsx packages/conformance/src/conformance-report.ts --require-feature deployment-native-daemon-v1 --output artifacts/conformance/production-native.json",
    "conformance:compare": "tsx packages/conformance/src/compare-reports.ts",
    "conformance:sqlite": "tsx packages/conformance/src/sqlite-differential.ts",
    "dev": "tsx apps/chronologd/src/main.ts",
    "cli": "tsx apps/chronolog/src/main.ts",
    "demo": "tsx examples/end-to-end.ts",
    "chaos": "tsx packages/chaos/src/cli.ts",
    "chaos:smoke": "tsx packages/chaos/src/cli.ts run smoke",
    "chaos:crash": "tsx packages/chaos/src/cli.ts run crash",
    "chaos:stress": "tsx packages/chaos/src/cli.ts run stress",
    "prepare": "husky"
  },
  "devDependencies": {
    "@chronolog/client": "workspace:*",
    "@chronolog/compiler-sqlite": "workspace:*",
    "@chronolog/ir": "workspace:*",
    "@chronolog/materializer-doltlite": "workspace:*",
    "@chronolog/migrations": "workspace:*",
    "@chronolog/runtime-workerd": "workspace:*",
    "@chronolog/node-core": "workspace:*",
    "@chronolog/protocol": "workspace:*",
    "@chronolog/rpc": "workspace:*",
    "@chronolog/transport-ssb": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "node-gyp": "11.5.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "blake3"
    ],
    "onlyBuiltDependencies": [
      "@dolthub/doltlite",
      "esbuild",
      "leveldown",
      "sodium-native"
    ],
    "patchedDependencies": {
      "@dolthub/doltlite@0.11.29": "patches/@dolthub__doltlite@0.11.29.patch",
      "async-append-only-log@4.3.10": "patches/async-append-only-log@4.3.10.patch"
    }
  }
}
