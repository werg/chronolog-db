{
  "format": "chronolog-chaos-scenario",
  "name": "restart_partition",
  "description": "Example four-node scenario with a minority partition and graceful validator restart.",
  "nodes": 4,
  "threshold": 3,
  "durationMs": 15000,
  "convergenceTimeoutMs": 60000,
  "checkpointEvery": 5,
  "cutoffLagMs": 10000,
  "workload": {
    "workers": 4,
    "intervalMs": 100,
    "accounts": 12,
    "minimumDelta": -5,
    "maximumDelta": 8,
    "maximumTransfer": 12,
    "resultSampleSize": 64,
    "operationWeights": {
      "migration_chain": 8,
      "migration_rollback": 6,
      "legacy_client_write": 9,
      "current_client_write": 9,
      "balance_update": 22,
      "transfer": 14,
      "ordered_touch": 7,
      "empty_returning": 3,
      "document_insert": 6,
      "ddl_sequence": 3,
      "precondition_rejection": 7,
      "constraint_rejection": 6
    }
  },
  "faults": [
    {
      "atMs": 2000,
      "durationMs": 3000,
      "kind": "partition",
      "groups": [["node-0", "node-1", "node-2"], ["node-3"]]
    },
    {
      "atMs": 7000,
      "kind": "restart",
      "node": "node-1"
    },
    {
      "atMs": 10000,
      "durationMs": 2500,
      "kind": "latency",
      "links": ["node-0->node-2", "node-2->node-0"],
      "latencyMs": 300,
      "jitterMs": 100
    }
  ]
}
