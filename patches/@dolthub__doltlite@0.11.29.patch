+Napi::Value ChronologNativeManifest(const Napi::CallbackInfo& info) {
+  Napi::Env env = info.Env();
+  Napi::Object manifest = Napi::Object::New(env);
+  manifest.Set("doltliteVersion", "0.11.29");
+  manifest.Set("doltliteSourceSha256", "6611b083ea08cf1e4a9ca71d8e873e9fccd989ad893d6ab38b3df3a48aeac6a8");
+  manifest.Set("sqliteVecVersion", "0.1.9");
