+  // async-append-only-log rewrites the mutable tail block in place. A process
+  // kill during a later rewrite can otherwise tear records which were already
+  // fsynced and replicated, causing a classic SSB author feed to fork after
+  // restart. Journal the complete target block before every overwrite and
+  // replay it before scanning the log on startup. A stale complete journal is
+  // safe to replay; a partial or corrupt journal is ignored because the main
+  // file has not yet been touched for that write.
+  function checksum(blockBuf) {
+    return crypto.createHash('sha256').update(blockBuf).digest()
